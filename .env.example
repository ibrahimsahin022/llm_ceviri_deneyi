# Bu dosyayi ".env" olarak kopyalayip gercek anahtarlarinizi girin.
# ".env" .gitignore'da haric tutulmustur, asla commit edilmez.

# Google AI Studio (Gemini) - aistudio.google.com/apikey
GOOGLE_API_KEY=
# Varsayilan model: gemini-flash-latest. Degistirmek icin:
# GEMINI_MODEL=gemini-2.5-pro

# OpenAI - platform.openai.com/api-keys
OPENAI_API_KEY=
# Varsayilan model: gpt-4o. Degistirmek icin:
# OPENAI_MODEL=gpt-4o-mini

# DeepSeek - platform.deepseek.com (OpenAI-uyumlu API)
DEEPSEEK_API_KEY=
# Varsayilan model: deepseek-chat. Degistirmek icin:
# DEEPSEEK_MODEL=deepseek-reasoner
